
name: Build All FM Radio APK

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Extract Android project
        run: unzip -q AllFMRadio-Mobile-Build.zip -d source

      - name: Build APK
        run: gradle -p source/AllFMRadio assembleDebug

      - uses: actions/upload-artifact@v4
        with:
          name: AllFMRadio-APK
          path: source/AllFMRadio/app/build/outputs/apk/debug/app-debug.apk
